# Monik — пример переменных окружения.
#
# Скопировать в .env и заполнить реальными значениями. Файл .env в Git не попадает.
# Секреты задаются только здесь: в config/config.example.yaml находятся лишь
# ссылки { env: "MONIK_..." } (17_CONFIGURATION.md §5, §26, §46).
#
# Provider, включённый в конфигурации, обязан иметь заданную переменную:
# отсутствие значения останавливает старт приложения, а не подставляет пустой ключ.

# --- Aggregator API credentials ---------------------------------------------
MONIK_ONEINCH_API_KEY=
MONIK_ZEROX_API_KEY=
MONIK_VELORA_API_KEY=
MONIK_UNISWAP_API_KEY=

# --- Telegram ---------------------------------------------------------------
# Требуются, только если notifications.telegram.enabled = true.
MONIK_TELEGRAM_BOT_TOKEN=
MONIK_TELEGRAM_CHAT_ID=

# --- Переопределение любых параметров конфигурации ---------------------------
# Формат: MONIK__<путь>__<в>__<документе> (двойное подчёркивание = уровень вложенности).
# Приоритет: environment override > config.yaml > безопасный default.
#
# Примеры:
#   MONIK__APPLICATION__ENVIRONMENT=production
#   MONIK__SCANNER__LEVEL1__INTERVAL_SECONDS=60
#   MONIK__SCANNER__LEVEL2__MAX_PARALLEL=20
#   MONIK__PROFITABILITY__FINAL_THRESHOLD_PERCENT=1.50
#   MONIK__DATABASE__PATH=/var/lib/monik/monik.db
#   MONIK__LOGGING__LEVEL=INFO
